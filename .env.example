# Leave any section blank to skip that data source.

# Google Keyword Planner (search volume, CPC, competition)
# https://developers.google.com/google-ads/api/docs/get-started/introduction
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Optional: only if you access the account through a manager (MCC) account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional: override the Google Ads API version (default v26).
GOOGLE_ADS_API_VERSION=
